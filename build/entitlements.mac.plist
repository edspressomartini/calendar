<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements (docs/spec.md §8.8).

  allow-jit: V8 requires it.

  personal-information.calendars: EventKit reads the macOS calendar store.
  Read-only use; the app never writes an event. TCC still gates it behind the
  user's own Allow, and the usage string is in Info.plist.

  disable-library-validation used to be here, because an ad-hoc signature has
  no Team ID and the app could not load its own Electron framework without it.
  Signing with a Developer ID gives every nested binary the same Team ID, so
  library validation is satisfied and the entitlement is gone.

  Deliberately absent: allow-dyld-environment-variables, which really would
  open a code-injection path, and allow-unsigned-executable-memory. Add an
  entitlement only if a signed build genuinely fails without it, and record
  the reason in the spec.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
  </dict>
</plist>
