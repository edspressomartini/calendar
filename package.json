{
  "name": "up-next",
  "productName": "Up Next",
  "version": "0.2.1",
  "description": "An always-on-top macOS widget showing today's calendar.",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "check-node": "node scripts/check-node.mjs",
    "setup": "npm ci && node node_modules/electron/install.js",
    "dev": "npm run check-node && electron-vite dev",
    "build": "npm run check-node && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "package": "npm run build && electron-builder --mac --publish never",
    "install:local": "./scripts/install-local.sh",
    "icons": "npm run check-node && node scripts/generate-tray-icon.ts && node scripts/generate-app-icon.ts && iconutil -c icns -o build/icon.icns build/icon.iconset",
    "spike:oauth": "npm run check-node && node --env-file-if-exists=.env.local scripts/oauth-spike.ts",
    "audit": "npm run check-node && node scripts/audit.ts"
  },
  "dependencies": {
    "@googleapis/calendar": "20.0.1",
    "electron-log": "5.4.4",
    "electron-store": "11.0.2",
    "google-auth-library": "11.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "5.0.1"
  },
  "overrides": {
    "source-map-js": "1.2.2"
  }
}
