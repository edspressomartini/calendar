<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Local builds only, on a machine with no Developer ID certificate.

  electron-builder falls back to an ad-hoc signature when it cannot find a
  certificate. An ad-hoc signature has no Team ID, so library validation has
  nothing to match the app's own Electron framework against and the app will
  not start. This file adds the one entitlement that tolerates that.

  Released builds use build/entitlements.mac.plist, which does not contain it.
  See the README for the command that selects this file.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
